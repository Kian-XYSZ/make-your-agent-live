# 复制成 .env 后填写，或者写进 ~/.dsh/.credentials.yaml
#
# 只要填你要用的那几个，没填的会自动降级。

# ── TTS ──
# MiMo（默认，限时免费，支持克隆 + 音色设计）
XIAOMI_API_KEY=

# MiniMax（有会员就含 TTS 和 ASR）
MINIMAX_API_KEY=
# MiniMax T2A 需要 GroupId（控制台 → 账户信息）
MINIMAX_GROUP_ID=

# 本地 TTS 服务（任何兼容 HTTP 的都能接）
LOCAL_TTS_ENDPOINT=http://127.0.0.1:9880/tts

# ── ASR ──
# DeepSeek（0.39 元/小时）
DEEPSEEK_API_KEY=

# 本地 ASR 服务（whisper.cpp / SenseVoice 等）
LOCAL_ASR_ENDPOINT=http://127.0.0.1:9881/transcribe

# ── QQ / OneBot 11 ──
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=
