{
  "name": "make-your-agent-live",
  "version": "0.2.0",
  "description": "让 agent 像人一样在 QQ 里主动跟你说话：克隆专属音色、听懂语音、会主动找你（AI 助理 / AI 宠物）。不绑定框架，DSH / Claude Code / Cursor 都能用。⚠️ QQ 接入走个人号协议端，有封号风险，请用小号测试，不推荐商用。",
  "type": "module",
  "bin": {
    "myal": "./cli/index.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./dsh": "./adapters/dsh/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./adapters/dsh/cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepublishOnly": "node scripts/check-files.mjs",
    "check": "node scripts/check-files.mjs",
    "doctor": "node ./cli/index.js doctor",
    "selftest": "node ./cli/index.js doctor --full"
  },
  "files": [
    "AGENTS.md",
    "START.md",
    "README.md",
    "LICENSE",
    "cli",
    "src",
    "adapters",
    "personas",
    "docs",
    ".env.example"
  ],
  "keywords": [
    "agent",
    "tts",
    "asr",
    "voice-clone",
    "qq",
    "onebot",
    "snowluma",
    "dsh",
    "dsh-plugin",
    "claude-code",
    "ai-companion"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kian-XYSZ/make-your-agent-live.git"
  },
  "homepage": "https://github.com/Kian-XYSZ/make-your-agent-live#readme",
  "bugs": {
    "url": "https://github.com/Kian-XYSZ/make-your-agent-live/issues"
  }
}
